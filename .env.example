# Google Gemini - gratis, sin tarjeta: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Groq - gratis, sin tarjeta: https://console.groq.com
GROQ_API_KEY=

# OpenAI - de pago desde el primer uso: https://platform.openai.com/account/api-keys
# Opcional: si se deja vacio, el script de validacion la usa a proposito
# como prueba de resiliencia (error controlado, sin crash).
OPENAI_API_KEY=

# Pinecone (Fase 4) - free tier, sin tarjeta: https://app.pinecone.io
PINECONE_API_KEY=

# Redis (Fase 7) - persistencia de estado de jobs + checkpointer de LangGraph.
# Free tier sin tarjeta: https://console.upstash.com (o cualquier otro Redis,
# local o en la nube - formato redis://user:pass@host:puerto/0 o rediss://... para TLS)
REDIS_URL=

# LangSmith (Fase 7) - observabilidad. Free tier sin tarjeta: https://smith.langchain.com
LANGSMITH_API_KEY=

# --- Sistema Final: configuracion (todas opcionales; estos son los valores por defecto) ---
# Indice y namespace de Pinecone con el corpus (ya existen de la Fase 4).
PINECONE_INDEX_NAME=proyecto-ch-ai-fase4
PINECONE_NAMESPACE=fase4-corpus
PINECONE_TOP_K=5
# Modelo de Groq para supervisor y especialistas.
GROQ_MODEL=openai/gpt-oss-120b
# Jobs en paralelo (limite para no superar el TPM de Groq free tier).
MAX_JOBS_CONCURRENTES=2
RECURSION_LIMIT=15
# Proyecto de LangSmith donde se guardan las trazas del Sistema Final.
LANGSMITH_PROJECT=proyecto-ch-ai-final
# Puerto de la API al usar ./run.sh.
PORT=8000
